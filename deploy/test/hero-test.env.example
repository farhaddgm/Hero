# Non-secret example for the Hero Test stack.
# Store the real values in the approved runtime secret channel, not in Git.

HERO_HTTP_HOST=0.0.0.0
HERO_HTTP_PORT=3100
HERO_BIND_ADDRESS=127.0.0.1
HERO_EXPOSE_PORT=43101
HERO_DATA_DIR=/var/lib/hero
HERO_LOG_LEVEL=info

# Required for operational API access. Inject a real value at runtime.
HERO_OWNER_AUTH_SECRET=

# Optional but recommended for the separate, limited Admin session. Inject a real value at runtime.
HERO_ADMIN_AUTH_SECRET=

# Required for the protected Back Office. Inject real values at runtime.
HERO_BACKOFFICE_USER=
HERO_BACKOFFICE_PASSWORD=

# Test must have its own PostgreSQL database and password.
HERO_POSTGRES_URL=
HERO_POSTGRES_PASSWORD=
HERO_REQUIRE_POSTGRES=true

# Keep live Provider calls disabled in the initial Test environment.
HERO_ENABLE_REAL_PROVIDERS=false
