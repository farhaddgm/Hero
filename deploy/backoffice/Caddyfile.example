# Copy/apply this file only in the server's approved Caddy configuration.
# Do not commit the rendered file or any password/hash.

hero.beeproject.ir {
    encode gzip

    header {
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-DNS-Prefetch-Control "off"
        -Server
    }

    # Every browser page is explicitly allow-listed. API routes stay behind the
    # application's human-session authorization, not Caddy Basic Auth alone.
    @backoffice path /backoffice /backoffice-data /backoffice-events /identity /product-studio /product-studio-data /product-studio-document /portfolio /portfolio-data /project-control /project-control-data /workspace /robots.txt
    handle @backoffice {
        basic_auth {
            {$HERO_BACKOFFICE_USER} {$HERO_BACKOFFICE_PASSWORD_HASH}
        }
        reverse_proxy 127.0.0.1:43100
    }

    # The page uses owner-signed Bearer sessions for API reads and mutations.
    # The application remains the authorization boundary for every /api/* route.
    @hero_api path /api/*
    handle @hero_api {
        reverse_proxy 127.0.0.1:43100
    }

    respond 404 "not found" 404
}
