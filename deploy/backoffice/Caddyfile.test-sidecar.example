# Render this file only for the isolated Hero Test authentication sidecar.
# Keep the rendered file outside Git at /etc/hero/caddy-test/Caddyfile.
# HERO_BACKOFFICE_PASSWORD_HASH must be supplied by the sidecar runtime; never
# replace it with a plaintext password or commit the rendered configuration.
:8080 {
    encode gzip

    header {
        Cache-Control "no-store"
        X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, notranslate"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-DNS-Prefetch-Control "off"
        -Server
    }

    @hero_test_backoffice path /backoffice /backoffice-data /backoffice-events /identity /product-studio /product-studio-data /product-studio-document /portfolio /portfolio-data /project-control /project-control-data /workspace /walkthrough /robots.txt
    handle @hero_test_backoffice {
        basic_auth {
            {$HERO_BACKOFFICE_USER} {$HERO_BACKOFFICE_PASSWORD_HASH}
        }
        reverse_proxy control-plane:3100
    }

    # Browser pages use cookie-backed Human Identity for their project-scoped
    # API calls.  The advisor, Workspace and every other UI fetch therefore
    # need the same proxy path as the page itself.  Do not turn this matcher
    # into a credential bypass: Control Plane verifies the Human session,
    # Project Grant, CSRF origin and every mutation separately.
    @hero_test_api path /api/*
    handle @hero_test_api {
        reverse_proxy control-plane:3100
    }

    @hero_test_health path /health /ready
    handle @hero_test_health {
        reverse_proxy control-plane:3100
    }

    respond "Not Found" 404
}
