# Public values only. Copy secret values to the protected runtime store, never to this file.
HERO_HTTP_HOST=0.0.0.0
HERO_HTTP_PORT=3100
HERO_BIND_ADDRESS=127.0.0.1
HERO_EXPOSE_PORT=43100
HERO_DATA_DIR=/var/lib/hero
HERO_LOG_LEVEL=info

# Authentication values must be unique to Production.
HERO_OWNER_AUTH_SECRET=
HERO_ADMIN_AUTH_SECRET=
HERO_BACKOFFICE_USER=
HERO_BACKOFFICE_PASSWORD=

# Production must use its own PostgreSQL credentials and database resources.
HERO_POSTGRES_URL=
HERO_POSTGRES_PASSWORD=
HERO_REQUIRE_POSTGRES=true

# Live providers remain disabled until their independent authorization is recorded.
HERO_ENABLE_REAL_PROVIDERS=false
HERO_OPENAI_COST_UNITS_PER_1K_TOKENS=
HERO_ANTHROPIC_COST_UNITS_PER_1K_TOKENS=
HERO_GOOGLE_COST_UNITS_PER_1K_TOKENS=
HERO_OPENAI_COMPATIBLE_COST_UNITS_PER_1K_TOKENS=
HERO_OPENAI_API_KEY=
HERO_ANTHROPIC_API_KEY=
HERO_GOOGLE_API_KEY=
HERO_OPENAI_COMPATIBLE_API_KEY=
