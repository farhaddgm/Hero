        "externalIntegrations": "no",
        "requiresPrivilegedAccess": "unknown"
      },
      "riskRationale": {
        "externalIntegrations": "قالب هیچ فراخوانی به سرویس بیرونی و هیچ اسکریپت شخص ثالث ندارد.",
